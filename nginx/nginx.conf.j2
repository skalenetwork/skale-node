load_module modules/ngx_http_js_module.so;

user  nginx;
worker_processes  auto;
worker_rlimit_nofile 131072;
# old workers finish long snapshot downloads after a reload, up to this long
worker_shutdown_timeout 1h;

error_log  /var/log/nginx/error.log notice;
pid        /run/nginx.pid;

events {
    worker_connections  65536;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    keepalive_timeout  65;
    server_tokens off;

    # sChain RPC call checks, see njs/rpc.js
    js_import rpc from /etc/nginx/njs/rpc.js;
    js_shared_dict_zone zone=rpc_counters:16m timeout=60s type=number evict;
    js_shared_dict_zone zone=rpc_bans:4m timeout=60s type=number evict;

    include /etc/nginx/conf.d/*.conf;
}
